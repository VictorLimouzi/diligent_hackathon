#!/usr/bin/env python3
"""Decide every watchlist hit in a data folder.

Usage: system/run <data folder> <output file>

Reads only the given folder. Writes one JSON line per hit with hit_id,
alert_id, decision, reason_code, customer_record_id, reason and evidence.
Python 3 standard library only; no network and no language model, so the same
input always gives the same output.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

from casebook.engine import decide_all  # noqa: E402
from casebook.export import write_decisions  # noqa: E402
from casebook.load import Data  # noqa: E402


def review_everything(folder, out, why):
    """Last resort when the data cannot be loaded as expected: answer every hit
    with REVIEW rather than write nothing. A hit is never cleared on a failure."""
    import json
    path = os.path.join(folder, "hits.jsonl")
    rows = []
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            try:
                h = json.loads(line)
            except ValueError:
                continue
            if isinstance(h, dict) and h.get("hit_id"):
                rows.append({
                    "hit_id": h["hit_id"], "alert_id": h.get("alert_id"), "decision": "REVIEW",
                    "reason_code": "INSUFFICIENT_DATA", "customer_record_id": None,
                    "reason": "The system could not read this data folder as expected (%s). "
                              "Nothing was compared, so a person must review the hit." % why,
                    "evidence": []})
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")
    return len(rows)


def main(argv):
    if len(argv) != 3:
        sys.stderr.write(__doc__)
        return 2
    folder, out = argv[1], argv[2]
    try:
        data = Data(folder)
        results = decide_all(data, on_error=lambda alert, exc: sys.stderr.write(
            "warning: %s sent to REVIEW after %s: %s\n" % (alert.get("alert_id"), type(exc).__name__, exc)))
        # Every hit in the folder gets a line, including any that no alert lists.
        answered = {r["hit_id"] for r in results}
        for hit_id, hit in data.hits.items():
            if hit_id not in answered:
                results.append({
                    "hit_id": hit_id, "alert_id": hit.get("alert_id"), "decision": "REVIEW",
                    "reason_code": "INSUFFICIENT_DATA", "customer_record_id": None,
                    "reason": "No alert in the data folder lists this hit, so the customer it was raised "
                              "for is not known. Nothing can be compared, so a person must review it.",
                    "evidence": []})
        write_decisions(results, out)
    except Exception as exc:  # noqa: BLE001
        n = review_everything(folder, out, type(exc).__name__)
        sys.stderr.write("error: %s: %s; wrote REVIEW for %d hits\n" % (type(exc).__name__, exc, n))
        return 0
    counts = {}
    for r in results:
        counts[r["decision"]] = counts.get(r["decision"], 0) + 1
    sys.stderr.write("%d hits decided: %s\n" % (
        len(results), ", ".join("%s %d" % kv for kv in sorted(counts.items()))))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
